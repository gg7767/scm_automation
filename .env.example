DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/scm_automation

# PO PDF letterhead
COMPANY_NAME=Precast Co. Pvt. Ltd.
COMPANY_ADDRESS=Plot 1, Industrial Area, Hyderabad, Telangana
COMPANY_GSTIN=
COMPANY_STATE=TG

# Email (urgent-indent alerts, maintenance/min-stock alerts, monthly SCM pack).
# Defaults to the console backend (prints to stdout) — set real SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=scm-automation@example.com

# Business-policy tolerances (all optional, shown with their defaults)
GRN_OVER_RECEIPT_TOLERANCE_PERCENT=2.0
BILL_MATCH_QTY_TOLERANCE_PERCENT=0.0
BILL_MATCH_RATE_TOLERANCE_PERCENT=0.0
BILL_MATCH_TOTAL_TOLERANCE_RUPEES=1.0
ALLOW_NEGATIVE_STOCK=False
